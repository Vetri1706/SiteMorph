VITE_SITEMORPH_BACKEND_URL=/api

# Server-only FortyGuard configuration. Never prefix these with VITE_.
FORTYGUARD_API_KEY=
# Optional server-only comma-separated rollover keys. They are attempted in
# order only after a definitive invalid-key or exhausted-credit response.
FORTYGUARD_FALLBACK_API_KEYS=
FORTYGUARD_API_URL=https://api.fortyguard.com/v1
# Full first-run evidence: 3 representative hot-season dates × 4 core analyses,
# followed by environmental, required satellite, and street-edge context.
FORTYGUARD_ANALYSIS_DATES=2023-07-15,2024-07-15,2025-07-15
FORTYGUARD_GRANULARITY=60
# One explicitly approved uncached run may submit at most 15 activities.
# Completed same-AOI reruns are cache-only and submit zero new activities.
FORTYGUARD_MAX_NEW_ACTIVITIES=15
FORTYGUARD_INCLUDE_OPTIONAL_EVIDENCE=true
FORTYGUARD_MAX_POLL_ATTEMPTS=60
FORTYGUARD_POLL_INTERVAL_MS=2000
# Keep stable when enabling full evidence: the cache identity already includes
# the evidence mode. Increment only for an incompatible cache-schema change.
FORTYGUARD_CACHE_VERSION=v1
VITE_FORTYGUARD_OPTIONAL_EVIDENCE=true
VITE_FORTYGUARD_PAID_ANALYSIS=true

# Hosted runtime only. One full-evidence AOI is guarded by a persistent lifetime
# ceiling of 15; fallback credentials never expand this budget.
SITEMORPH_HOSTED_ACTIVITY_BUDGET=15

# Never place FortyGuard keys, Autodesk client secrets, or backend credentials here.
