VITE_SITEMORPH_BACKEND_URL=/api

# Server-only FortyGuard configuration. Never prefix these with VITE_.
FORTYGUARD_API_KEY=
# Optional server-only comma-separated rollover keys. They are attempted in
# order only after a definitive invalid-key or exhausted-credit response.
FORTYGUARD_FALLBACK_API_KEYS=
FORTYGUARD_API_URL=https://api.fortyguard.com/v1
# Credit Saver defaults: 3 representative hot-season dates × 4 core analyses.
FORTYGUARD_ANALYSIS_DATES=2023-07-15,2024-07-15,2025-07-15
FORTYGUARD_GRANULARITY=60
# Safe local default: exact saved AOIs only. For one explicitly approved full
# local run, use 15 (12 thermal + 3 enrichment), set both optional-evidence
# flags true, and enable the paid-analysis UI. Completed reruns stay cache-only.
FORTYGUARD_MAX_NEW_ACTIVITIES=0
FORTYGUARD_INCLUDE_OPTIONAL_EVIDENCE=false
FORTYGUARD_MAX_POLL_ATTEMPTS=60
FORTYGUARD_POLL_INTERVAL_MS=2000
# Increment only when intentionally invalidating persisted analysis identities.
FORTYGUARD_CACHE_VERSION=v1
VITE_FORTYGUARD_OPTIONAL_EVIDENCE=false
VITE_FORTYGUARD_PAID_ANALYSIS=false

# Hosted runtime only. The public workflow remains core-only and guarded by a
# persistent lifetime ceiling; fallback credentials never expand this budget.
SITEMORPH_HOSTED_ACTIVITY_BUDGET=12

# Never place FortyGuard keys, Autodesk client secrets, or backend credentials here.
